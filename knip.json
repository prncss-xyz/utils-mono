{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": ["oxfmt.config.ts!"]
		},
		"apps/web": {
			"entry": ["index.html!"],
			"project": ["src/**/*.{ts,tsx}!"]
		},
		"packages/react-utils": {
			"entry": ["src/index.ts!", "stryker.vitest.config.ts!"],
			"project": [
				"**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,mdx}!",
				"!**/*.testing.ts!"
			]
		}
	},
	"ignoreBinaries": ["typos", "vp"],
	"ignoreDependencies": [
		"@astryxdesign/cli",
		"@astryxdesign/core",
		"@astryxdesign/theme-neutral",
		"@commitlint/cli",
		"bumpp"
	]
}
